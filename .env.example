# Copia este archivo a .env.local y completa los valores reales.
# .env.local nunca se sube a git (ver .gitignore).

# Requerido. API key de Resend (https://resend.com) — se obtiene en
# Dashboard → API Keys. Empieza con "re_".
RESEND_API_KEY=

# Opcional. Dirección que recibe las consultas del formulario.
# Si se omite, el código usa "contacto@lexmigratio.com" por defecto.
CONTACT_TO_EMAIL=contacto@lexmigratio.com

# Opcional. Dirección remitente. DEBE pertenecer a un dominio verificado en
# Resend (Dashboard → Domains). Mientras el dominio lexmigratio.com no esté
# verificado, se puede usar la dirección de pruebas de Resend
# ("onboarding@resend.dev"), que es el valor por defecto si se omite esta
# variable.
CONTACT_FROM_EMAIL="LEX MIGRATIO <onboarding@resend.dev>"
